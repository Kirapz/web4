{
  "functions": [
    {
      "source": "my-backend",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log", 
        "*.local"
      ]
    }
  ],
  "hosting": {
    "public": "../my-react-app/build",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
